<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/style.css">
    <title>Contacts</title>
</head>
<body>
    <main>
        <a href="/contacts">retour</a>
        <h1>Nouveau Contact</h1>

        <!--
            BLOC CONDITIONNEL (syntaxe Mustache)
            = n'est affiché que si l'attribut "contact" du Model est non nul
        -->
        {{#contact}}
        <p class="confirmation">
            <!-- {{contact}} est remplacé par l'attribut "contact" du Model -->
            Le contact {{contact}} a bien été créé
        </p>
        {{/contact}}

        <form action="/contacts/nouveau" method="post">
            <input type="text" name="nom" placeholder="Nom">
            <button>Créer</button>
        </form>
    </main>
</body>
</html>